# Public site origin used by sitemap and robots generation.
PUBLIC_SITE_URL=https://aevumstack.dev

# Fastify and local PostgreSQL. Keep server settings out of VITE_ variables.
DATABASE_URL=postgres://replace_user:replace_password@127.0.0.1:5432/aevumstack_dev
API_HOST=127.0.0.1
API_PORT=3001
# Exact browser origins allowed to POST. No wildcard values.
API_ALLOWED_ORIGINS=http://127.0.0.1:5173
# Generate at least 32 random bytes for a real local .env; this placeholder is rejected.
IDEMPOTENCY_HMAC_KEY=replace-this-placeholder-with-at-least-32-random-bytes
# Local-only, per-process POST rate limit. Do not treat this as public-deployment protection.
API_RATE_LIMIT_MAX=5
API_RATE_LIMIT_WINDOW_MS=60000

# The outbox worker uses loopback Mailpit. Keep relay and forwarding off.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
OUTBOX_MAX_ATTEMPTS=5

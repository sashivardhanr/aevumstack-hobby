# Copy to .env.local-runtime and generate each secret separately with openssl rand -hex 32.
# Optional. Keep the default to reuse the established local volume. A new name creates a separate volume.
# LOCAL_COMPOSE_PROJECT=aevumstack-local
LOCAL_POSTGRES_PASSWORD=
IDEMPOTENCY_HMAC_KEY=
LOCAL_PG_PORT=15432
LOCAL_SMTP_PORT=11025
LOCAL_MAILPIT_PORT=18025

# Optional for the native-host workflow only. Use a dedicated loopback database.
# DATABASE_URL=postgres://local_user@127.0.0.1:15432/aevumstack_dev
